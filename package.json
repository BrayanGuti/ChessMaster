{
  "name": "chessmaster-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run typecheck -w packages/react-chessmaster && npm run build -w apps/web",
    "build:package": "npm run build -w packages/react-chessmaster",
    "lint": "eslint .",
    "preview": "npm run preview -w apps/web",
    "test": "npm test -w packages/react-chessmaster --",
    "test:ui": "npm run test:ui -w packages/react-chessmaster",
    "test:coverage": "npm run test:coverage -w packages/react-chessmaster",
    "deploy": "npm run deploy -w apps/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.0"
  }
}
