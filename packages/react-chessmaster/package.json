{
  "name": "@brayanguti/react-chessmaster",
  "version": "0.1.1",
  "description": "A complete, drop-in chess board for React: full rules, play a friend or the computer, drag and drop, themes, sounds and saved games.",
  "license": "MIT",
  "author": "Brayan Gutierrez (https://github.com/BrayanGuti)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrayanGuti/ChessMaster.git",
    "directory": "packages/react-chessmaster"
  },
  "homepage": "https://github.com/BrayanGuti/ChessMaster#readme",
  "bugs": "https://github.com/BrayanGuti/ChessMaster/issues",
  "keywords": [
    "chess",
    "chessboard",
    "react",
    "react-component",
    "board-game",
    "game",
    "chess-ai",
    "chess-engine",
    "nextjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "THIRD_PARTY_LICENSES.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@vitest/ui": "^5.0.1",
    "js-chess-engine": "^2.4.6",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1"
  }
}
